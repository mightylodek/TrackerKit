<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Registers the deep-link scheme the widget uses.
	     WidgetKit may deliver `widgetURL` to the owning app without this, but
	     nothing else will: any link from outside the widget (a shortcut, a
	     notification, `simctl openurl`) fails with -10814 unless the scheme is
	     declared here. Registering removes the ambiguity entirely. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.mightylodek.software.trackerdash.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>trackerdash</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
